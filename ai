			})

			corner(row, 7)
			hover(row, row.BackgroundColor3, theme("ButtonHover", Color3.fromRGB(57, 57, 65)))

			local typeBadge = make("TextLabel", {
				Size = UDim2.fromOffset(31, 18),
				Position = UDim2.fromOffset(8 + indentOffset, 5),
				BackgroundColor3 = classColor,
				BorderSizePixel = 0,
				Text = icon:gsub("%[", ""):gsub("%]", ""),
				TextColor3 = Color3.fromRGB(12, 12, 14),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				Font = Enum.Font.GothamBold,
				TextSize = 8,
				ZIndex = row.ZIndex + 1,
				Parent = row
			})

			corner(typeBadge, 5)

			make("TextLabel", {
				Size = UDim2.new(1, -(48 + indentOffset), 1, 0),
				Position = UDim2.fromOffset(44 + indentOffset, 0),
				BackgroundTransparency = 1,
				Text = rowText,
				TextColor3 = theme("Text", Color3.fromRGB(240, 240, 245)),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				ZIndex = row.ZIndex + 1,
				Parent = row
			})

			panel.Rows[instance] = row

			local touchHolding = false
			local touchHoldStarted = 0
			local suppressNextClick = false

			row.InputBegan:Connect(function(inputObject)
				-- PC: use right-click for options, normal left-click only selects/expands.
				if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
					suppressNextClick = true
					showContextMenu(instance, inputObject.Position)
					return
				end

				-- Mobile: hold/tap-and-hold opens options. Quick tap selects/expands.
				if inputObject.UserInputType == Enum.UserInputType.Touch then
					touchHolding = true
					touchHoldStarted = os.clock()

					task.delay(0.62, function()
						if touchHolding and os.clock() - touchHoldStarted >= 0.6 then
							touchHolding = false
							suppressNextClick = true
							showContextMenu(instance, inputObject.Position)
						end
					end)
				end
			end)

			row.InputEnded:Connect(function(inputObject)
				if inputObject.UserInputType == Enum.UserInputType.Touch then
					touchHolding = false
				end
			end)

			row.MouseButton1Click:Connect(function()
				if suppressNextClick then
					suppressNextClick = false
					return
				end

				menu.Visible = false
				panel.Selected = instance
				renderInspector(instance)

				if hasChildren then
					panel.Expanded[instance] = not panel.Expanded[instance]
					panel:RenderTree()
				else
					panel:RenderTree()
				end
			end)

			if expanded and hasChildren then
				children = sortChildren(children)

				for _, child in ipairs(children) do
					addRow(child, depth + 1)
				end
			end
		end

		function panel:RenderTree()
			clearChildren(tree)
			panel.Rows = {}

			local query = trim(searchBox.Text)

			if query ~= "" then
				local lower = query:lower()
				local count = 0
				local limit = tonumber(config.SearchLimit) or 250

				for _, root in ipairs(getRoots()) do
					local list = { root }

					local ok, descendants = pcall(function()
						return root:GetDescendants()
					end)

					if ok then
						for _, item in ipairs(descendants) do
							table.insert(list, item)
						end
					end

					for _, item in ipairs(list) do
						if count >= limit then
							break
						end

						local haystack = (item.Name .. " " .. item.ClassName .. " " .. item:GetFullName()):lower()

						if haystack:find(lower, 1, true) then
							count += 1
							addRow(item, 0)
						end
					end

					if count >= limit then
						break
					end
				end

				if count == 0 then
					make("TextLabel", {
						Size = UDim2.new(1, 0, 0, 26),
						BackgroundTransparency = 1,
						Text = "No results.",
						TextColor3 = theme("Muted", Color3.fromRGB(155, 155, 165)),
						TextXAlignment = Enum.TextXAlignment.Left,
						Font = Enum.Font.GothamBold,
						TextSize = 10,
						Parent = tree
					})
				end

				return
			end

			for _, root in ipairs(getRoots()) do
				addRow(root, 0)
			end
		end

