	local RunService = game:GetService("RunService")

	local LocalPlayer = Players.LocalPlayer
	local Mouse = LocalPlayer and LocalPlayer:GetMouse()

	local Theme = Library.Theme or {}

	local function theme(name, fallback)
		return Theme[name] or fallback
	end

	local function make(className, props, children)
		local obj = Instance.new(className)

		for k, v in pairs(props or {}) do
			obj[k] = v
		end

		for _, child in ipairs(children or {}) do
			child.Parent = obj
		end

		return obj
	end

	local function corner(parent, radius)
		return make("UICorner", {
			CornerRadius = UDim.new(0, radius or 10),
			Parent = parent
		})
	end

	local function stroke(parent, color, thickness, transparency)
		return make("UIStroke", {
			Color = color or theme("StrokeSoft", Color3.fromRGB(42, 42, 48)),
			Thickness = thickness or 1,
			Transparency = transparency or 0.25,
			Parent = parent
		})
	end

	local function padding(parent, left, right, top, bottom)
		return make("UIPadding", {
			PaddingLeft = UDim.new(0, left or 0),
			PaddingRight = UDim.new(0, right or 0),
			PaddingTop = UDim.new(0, top or 0),
			PaddingBottom = UDim.new(0, bottom or 0),
			Parent = parent
		})
	end

	local function hover(button, normal, over)
		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = over
		end)

		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = normal
		end)
	end

	local function trim(text)
		return tostring(text or ""):match("^%s*(.-)%s*$")
	end

	local function safeClipboard(text)
		text = tostring(text or "")

		if type(setclipboard) == "function" then
			setclipboard(text)
			return true
		end

		if type(toclipboard) == "function" then
			toclipboard(text)
			return true
		end

		if type(set_clipboard) == "function" then
			set_clipboard(text)
			return true
		end

		return false
	end

	local function safeGet(instance, prop)
		local ok, value = pcall(function()
			return instance[prop]
		end)

		if ok then
			return value
		end

		return nil
	end

	local function getServiceName(instance)
		local services = {
			[Workspace] = "Workspace",
			[Players] = "Players",
			[ReplicatedStorage] = "ReplicatedStorage",
			[Lighting] = "Lighting",
			[StarterGui] = "StarterGui",
			[StarterPack] = "StarterPack",
			[StarterPlayer] = "StarterPlayer",
			[SoundService] = "SoundService",
			[Teams] = "Teams"
		}

		return services[instance]
	end

	local function makeSafeLuaPath(instance)
		if not instance then
			return "nil"
		end

		local chain = {}
		local current = instance

		while current and current ~= game do
			table.insert(chain, 1, current)
			current = current.Parent
		end

		local root = chain[1]

		if not root then
			return "nil"
		end

		local rootService = getServiceName(root)
		local path = rootService and ('game:GetService("%s")'):format(rootService) or "game"
		local startIndex = rootService and 2 or 1

		for i = startIndex, #chain do
			local safeName = chain[i].Name:gsub("\\", "\\\\"):gsub('"', '\\"')
			path ..= (':WaitForChild("%s")'):format(safeName)
		end

		return path
	end

	local function vector3Text(v)
		return ("%.2f, %.2f, %.2f"):format(v.X, v.Y, v.Z)
	end

	local function color3Text(c)
		return ("%d, %d, %d"):format(c.R * 255, c.G * 255, c.B * 255)
	end

	local function getRoots()
		local roots = {}

		if LocalPlayer and LocalPlayer.Character then
			table.insert(roots, LocalPlayer.Character)
		end

		table.insert(roots, Workspace)
		table.insert(roots, Players)
		table.insert(roots, ReplicatedStorage)
		table.insert(roots, Lighting)
		table.insert(roots, StarterGui)
		table.insert(roots, StarterPack)
		table.insert(roots, StarterPlayer)
		table.insert(roots, SoundService)
		table.insert(roots, Teams)

		return roots
	end

	local function sortChildren(children)
		table.sort(children, function(a, b)
			if a.ClassName == b.ClassName then
				return a.Name:lower() < b.Name:lower()
			end

			return a.ClassName:lower() < b.ClassName:lower()
		end)

		return children
	end

