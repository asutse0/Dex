			local expanded = panel.Expanded[instance] == true
			local prefix = hasChildren and (expanded and "▼" or "▶") or "•"
			local icon, classColor = getClassVisual(instance)
			local indentOffset = math.clamp(depth * 14, 0, 96)
			local rowText = prefix .. " " .. instance.Name .. "  [" .. instance.ClassName .. "]"

			local row = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = panel.Selected == instance and theme("Accent", Color3.fromRGB(90, 90, 100)) or theme("Panel2", Color3.fromRGB(24, 24, 28)),
