			end
		end)

		cancelPickButton.MouseButton1Click:Connect(function()
			setClickPickEnabled(false)
		end)

		confirmPickButton.MouseButton1Click:Connect(function()
			if not clickPickTarget then
				notify("Dex Click Item", "Click an object first.", 2)
				return
			end

			local target = clickPickTarget
			setClickPickEnabled(false)

			if not panel.Open then
				panel:OpenPanel()
			end

			task.defer(function()
				panel:FocusObject(target)
			end)

			notify("Dex", "Selected and focused in Dex panel.", 2)
		end)

		if Mouse then
			clickPickConnection = Mouse.Button1Down:Connect(function()
				if not clickPickEnabled then
					return
				end

				local target = Mouse.Target

				if not target then
					notify("Dex Click Item", "No world object under cursor.", 2)
					return
				end

				clickPickTarget = target
				pickHighlight.Adornee = target
				pickHighlight.Enabled = true
				confirmPickButton.Text = "Confirm"
				notify("Dex Click Item", "Target: " .. target:GetFullName(), 2)
			end)
		end

		UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
			if gameProcessed then
				return
			end

			if inputObject.KeyCode == Enum.KeyCode.Escape and panel.Open then
				panel:ClosePanel()
			end
		end)

		RunService.RenderStepped:Connect(function()
			if not panel.Open then
				return
			end

			local _, width, height, newXOffset, newYOffset = getMobileSize()

			if main.Size.X.Offset ~= width or main.Size.Y.Offset ~= height then
				main.Size = UDim2.fromOffset(width, height)
				main.Position = UDim2.new(1, newXOffset, 0.5, newYOffset)
			end
		end)

		renderInspector(nil)
		panel.Gui = gui
		panel.Main = main
		panel.MiniTab = miniTab
		panel.TopTools = topTools
		panel.Tree = tree
		panel.Inspector = inspector
		panel.Menu = menu

		self.DexPanel = panel
		return panel
	end

	function Library:AddDexToggle(tab, config)
		config = config or {}

		local panel = self:CreateDexSidePanel({
			Chat = config.Chat,
			SearchLimit = config.SearchLimit
		})

		local title = tab:AddLabel("Extra Tools")

		local toggleButton = tab:AddButton("Toggle Dex Inspector", function()
			panel:Toggle()
		end)

		local info = tab:AddLabel("Dex opens on the right. Tap an object to inspect. Hold/right-click a row for Copy Path / Paste to AI.")

		return panel
	end

	Library.Extensions = Library.Extensions or {}
	Library.Extensions.DexSidePanel = true

	return Library
end
