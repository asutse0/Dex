		local function viewObject(instance)
			local camera = Workspace.CurrentCamera

			if not camera then
				return false, "No camera."
			end

			if panel.ViewTarget == instance then
				return unviewCurrent()
			end

			local subject = getCameraSubject(instance)

			if not subject then
				return false, "No viewable part/humanoid found."
			end

			if not panel.ViewTarget then
				panel.OriginalCameraSubject = camera.CameraSubject
				panel.OriginalCameraType = camera.CameraType
			end

			panel.ViewTarget = instance
			camera.CameraType = Enum.CameraType.Custom
