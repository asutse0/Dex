			searchBox.Text = ""

			local current = instance

			while current and current ~= game do
				panel.Expanded[current] = true
				current = current.Parent
			end

			panel.Selected = instance
			panel:RenderTree()
			renderInspector(instance)
			panel:ScrollToObject(instance)
		end

