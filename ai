	local function findUsablePart(instance)
		if not instance then
			return nil
		end

		if instance:IsA("BasePart") then
			return instance
		end

		if instance:IsA("Model") then
			local primary = instance.PrimaryPart

			if primary and primary:IsA("BasePart") then
				return primary
			end

			local ok, pivot = pcall(function()
				return instance:GetPivot()
			end)

			if ok and pivot then
				for _, child in ipairs(instance:GetDescendants()) do
					if child:IsA("BasePart") then
						return child
					end
				end
			end
		end

		for _, child in ipairs(instance:GetDescendants()) do
			if child:IsA("BasePart") then
				return child
			end
		end

		local current = instance.Parent

		while current and current ~= game do
			if current:IsA("BasePart") then
				return current
			end

			if current:IsA("Model") then
				local primary = current.PrimaryPart

				if primary and primary:IsA("BasePart") then
					return primary
				end

				for _, child in ipairs(current:GetDescendants()) do
					if child:IsA("BasePart") then
						return child
					end
				end
			end

			current = current.Parent
		end

		return nil
	end

	local function getObjectCFrame(instance)
		if not instance then
			return nil
		end

		if instance:IsA("BasePart") then
			return instance.CFrame
		end

		if instance:IsA("Model") then
			local ok, pivot = pcall(function()
				return instance:GetPivot()
			end)

			if ok then
				return pivot
			end
		end

		local part = findUsablePart(instance)

		if part then
			return part.CFrame
		end

		return nil
	end

	local function getCameraSubject(instance)
		if not instance then
			return nil
		end

		if instance:IsA("Humanoid") then
			return instance
		end

		if instance:IsA("BasePart") then
			return instance
		end

		if instance:IsA("Model") then
			local humanoid = instance:FindFirstChildOfClass("Humanoid")

			if humanoid then
				return humanoid
			end
		end

		return findUsablePart(instance)
	end

	local function teleportLocalPlayerTo(instance)
		local character = LocalPlayer and LocalPlayer.Character

		if not character then
			return false, "No character."
		end

		local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")

		if not root then
			return false, "No HumanoidRootPart."
		end

		local targetCFrame = getObjectCFrame(instance)

		if not targetCFrame then
			return false, "No world position found for this object."
		end

		root.CFrame = targetCFrame + Vector3.new(0, 5, 0)
		return true, "Teleported."
	end

	local function getScriptSource(instance)
		if not instance or not (instance:IsA("LuaSourceContainer")) then
			return nil, "Not a LuaSourceContainer."
		end

		local source = safeGet(instance, "Source")

		if type(source) == "string" and source ~= "" then
			return source, nil
		end

		return nil, "Source is not accessible in this environment."
	end

	local function getObjectContext(instance)
		if not instance then
			return "No object selected."
		end

		local lines = {
			"Selected object:",
			"Name: " .. instance.Name,
			"ClassName: " .. instance.ClassName,
			"FullName: " .. instance:GetFullName(),
			"LuaPath: " .. makeSafeLuaPath(instance),
			"Parent: " .. (instance.Parent and instance.Parent:GetFullName() or "nil"),
			"Children: " .. tostring(#instance:GetChildren())
		}

		if instance:IsA("BasePart") then
			table.insert(lines, "Position: " .. vector3Text(instance.Position))
			table.insert(lines, "Size: " .. vector3Text(instance.Size))
			table.insert(lines, "Anchored: " .. tostring(instance.Anchored))
			table.insert(lines, "CanCollide: " .. tostring(instance.CanCollide))
			table.insert(lines, "CanTouch: " .. tostring(instance.CanTouch))
			table.insert(lines, "Transparency: " .. tostring(instance.Transparency))
			table.insert(lines, "Material: " .. tostring(instance.Material))
			table.insert(lines, "Color RGB: " .. color3Text(instance.Color))
		end

		if instance:IsA("Model") then
			local pivot = instance:GetPivot()
			table.insert(lines, "Pivot Position: " .. vector3Text(pivot.Position))
		end

		if instance:IsA("Humanoid") then
			table.insert(lines, "Health: " .. tostring(instance.Health))
			table.insert(lines, "MaxHealth: " .. tostring(instance.MaxHealth))
			table.insert(lines, "WalkSpeed: " .. tostring(instance.WalkSpeed))
			table.insert(lines, "JumpPower: " .. tostring(instance.JumpPower))
			table.insert(lines, "RigType: " .. tostring(instance.RigType))
		end

		if instance:IsA("GuiObject") then
			table.insert(lines, "Visible: " .. tostring(instance.Visible))
			table.insert(lines, "Position: " .. tostring(instance.Position))
			table.insert(lines, "Size: " .. tostring(instance.Size))
			table.insert(lines, "BackgroundTransparency: " .. tostring(instance.BackgroundTransparency))
		end

		if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			table.insert(lines, "Text: " .. tostring(instance.Text))
			table.insert(lines, "TextSize: " .. tostring(instance.TextSize))
			table.insert(lines, "Font: " .. tostring(instance.Font))
		end

		if instance:IsA("LuaSourceContainer") then
			local source, sourceError = getScriptSource(instance)
			table.insert(lines, "Script source readable: " .. tostring(source ~= nil))

			if source then
				table.insert(lines, "Source length: " .. tostring(#source) .. " characters")
				table.insert(lines, "Source preview:")
				table.insert(lines, string.sub(source, 1, 1000))
			else
				table.insert(lines, "Source note: " .. tostring(sourceError))
			end
		end

		if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") then
			table.insert(lines, "Remote type: " .. instance.ClassName)
		end

		local children = sortChildren(instance:GetChildren())

		if #children > 0 then
			table.insert(lines, "")
			table.insert(lines, "Children Preview:")

			for i = 1, math.min(#children, 25) do
				local child = children[i]
				table.insert(lines, "- " .. child.Name .. " [" .. child.ClassName .. "]")
			end

			if #children > 25 then
				table.insert(lines, "- ...and " .. tostring(#children - 25) .. " more")
			end
		end

		return table.concat(lines, "\n")
	end

	local function getMobileSize()
		local camera = Workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(900, 600)

		local mobile = viewport.X <= 760

		-- Keep Dex slimmer so the top Dex Tools bar does not overlap the header/minimize arrow.
		-- Desktop: right-side compact panel.
		-- Mobile: still readable, but not full-width.
		local width

		if mobile then
			width = math.floor(math.clamp(viewport.X * 0.78, 286, math.max(286, viewport.X - 28)))
		else
			width = math.floor(math.clamp(viewport.X * 0.34, 320, 360))
		end

		local height

		if mobile then
			height = math.floor(math.clamp(viewport.Y - 112, 330, math.max(330, viewport.Y - 72)))
		else
			height = math.floor(math.clamp(viewport.Y - 112, 410, 560))
		end

		-- Keep Dex fully flush to the right edge.
		-- Right edge of the panel = right edge of the screen.
		local xOffset = -width

		-- Keep the slimmer Dex panel at the right-center like the original position.
		-- Width stays compact, only the vertical position is restored to center.
		local yOffset = -math.floor(height / 2)

		return mobile, width, height, xOffset, yOffset
	end

